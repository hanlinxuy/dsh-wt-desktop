[Unit]
Description=dshssh exec-server (self-built headless runtime: process/fs RPC over WebSocket)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# Self-built Node runtime (plugin/lib/exec-server.js, ws bundled — the target only
# needs Node). Token read from ~/.config/dshssh/token (0600, generated at deploy).
# allow-cwd restricts process cwd + fs paths to the trusted workspace.
Environment=PATH=__NODE_DIR__:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=__NODE_BIN__ __REMOTE_BASE__/runtime/exec-server.js --listen ws://127.0.0.1:__EXEC_PORT__ --token-file %h/.config/dshssh/token --allow-cwd %h/workspaces/dshssh
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=default.target
